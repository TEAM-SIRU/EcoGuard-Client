# Build-time API endpoint for the EcoGuard server.
VITE_API_BASE_URL=https://ecoguard.https.gsmsv.site/api/v1

# DataGSM OAuth authorization endpoint. The app adds client_id, redirect_uri, response_type, and state.
VITE_GSM_AUTHORIZATION_URL=https://oauth.authorization.datagsm.kr/v1/oauth/authorize

# Public DataGSM client ID for the web application.
VITE_GSM_CLIENT_ID=your-datagsm-client-id

# Web callback URI registered with DataGSM. Use this web address, not the server API address.
# Use this exact value for both authorization redirect_uri and /auth/login redirectUri:
# https://ecoguard-web.https.gsmsv.site
